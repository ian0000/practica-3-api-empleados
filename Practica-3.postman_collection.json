{
  "info": {
    "name": "Práctica 3 - Gestión de empleados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Crea un empleado temporal, reutiliza su ID y lo elimina al finalizar. La API y MongoDB deben estar activos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "empleadoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Crear empleado temporal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Creado 201 con wrapper', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().success).to.eql(true); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('empleadoId', pm.response.json().data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/empleados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Demo defensa Postman\",\n  \"cargo\": \"Analista\",\n  \"departamento\": \"Sistemas\",\n  \"sueldo\": 1200\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Listado completo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Lista 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados"
          ]
        }
      }
    },
    {
      "name": "3. Listado paginado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Paginación 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().meta.limit).to.eql(2); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados?page=1&limit=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "4. Consulta por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Consulta 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "{{empleadoId}}"
          ]
        }
      }
    },
    {
      "name": "5. Actualización parcial",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PATCH 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.sueldo).to.eql(1500); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "{{empleadoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sueldo\": 1500\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Actualización completa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PUT 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "{{empleadoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Demo defensa Postman\",\n  \"cargo\": \"Analista senior\",\n  \"departamento\": \"Sistemas\",\n  \"sueldo\": 1800\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "7. Sueldo inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('DTO 400 con wrapper', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().success).to.eql(false); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "{{empleadoId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sueldo\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "8. ID inválido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ID inválido 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/no-es-un-id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "no-es-un-id"
          ]
        }
      }
    },
    {
      "name": "9. Eliminar empleado temporal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Eliminado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "{{empleadoId}}"
          ]
        }
      }
    },
    {
      "name": "10. Consultar eliminado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Ausente 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empleados",
            "{{empleadoId}}"
          ]
        }
      }
    }
  ]
}
